---
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import SidebarSublist from "./SidebarSublist.astro";
// @ts-ignore — virtual module provided by the plugin's Vite integration
import { changelog } from "virtual:starlight-theme-yeti/config";

const { sidebar } = Astro.locals.starlightRoute;

// With Starlight's auto-generated sidebar the plugin has no config array to
// add the changelog link to, so append it at render time instead.
const trim = (path: string) => path.replace(/\/$/, "");
const entries =
  changelog && !changelog.inSidebar
    ? [
        ...sidebar,
        {
          type: "link" as const,
          label: changelog.label,
          href: changelog.href,
          isCurrent: trim(Astro.url.pathname) === trim(changelog.href),
          badge: undefined,
          attrs: {},
        },
      ]
    : sidebar;
---

<div class="flex h-full flex-col px-3 py-4">
  <SidebarSublist sublist={entries} nestedCount={0} />
  <div class="mt-auto border-t border-(--sl-color-hairline) pt-4 md:hidden">
    <MobileMenuFooter {...Astro.props} />
  </div>
</div>

<script is:inline>
  (function () {
    const key = 'yeti-sidebar-groups';
    let state = {};
    try { state = JSON.parse(localStorage.getItem(key) || '{}'); } catch {}

    document.querySelectorAll('details[data-group]').forEach((details) => {
      const name = details.dataset.group;
      // A stored choice never hides the group holding the current page
      if (name in state && !details.dataset.current) details.open = state[name];
      details.addEventListener('toggle', () => {
        state[name] = details.open;
        localStorage.setItem(key, JSON.stringify(state));
      });
    });
  })();
</script>
