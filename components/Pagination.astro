---
import { Icon } from "astro-icon/components";
import { parseIcon } from "./parse-icon";

const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isRtl = dir === "rtl";
---

<div class="grid grid-cols-1 gap-4 py-6 sm:grid-cols-2">
  {prev && (() => {
    const { icon, text } = parseIcon(prev.label);
    return (
      <a href={prev.href} rel="prev" class="group flex items-center gap-3 rounded-xl border border-(--sl-color-hairline-light) p-4 no-underline transition-all hover:border-(--sl-color-accent) hover:shadow-sm">
        <svg class="h-4 w-4 shrink-0 text-(--sl-color-gray-3) transition-colors group-hover:text-(--sl-color-text-accent)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d={isRtl ? "M9 18l6-6-6-6" : "M15 18l-6-6 6-6"} />
        </svg>
        <span class="flex flex-col">
          <span class="text-xs text-(--sl-color-gray-3)">Previous</span>
          <span class="flex items-center gap-1.5 text-sm font-medium text-(--sl-color-white) transition-colors group-hover:text-(--sl-color-text-accent)">
            {icon && <Icon name={icon} width="14" height="14" class="shrink-0 opacity-70" />}
            {text}
          </span>
        </span>
      </a>
    );
  })()}
  {next && (() => {
    const { icon, text } = parseIcon(next.label);
    return (
      <a href={next.href} rel="next" class:list={["group flex items-center gap-3 rounded-xl border border-(--sl-color-hairline-light) p-4 no-underline transition-all hover:border-(--sl-color-accent) hover:shadow-sm", !prev && "sm:col-start-2"]}>
        <span class="flex flex-1 flex-col text-right">
          <span class="text-xs text-(--sl-color-gray-3)">Next</span>
          <span class="flex items-center justify-end gap-1.5 text-sm font-medium text-(--sl-color-white) transition-colors group-hover:text-(--sl-color-text-accent)">
            {icon && <Icon name={icon} width="14" height="14" class="shrink-0 opacity-70" />}
            {text}
          </span>
        </span>
        <svg class="h-4 w-4 shrink-0 text-(--sl-color-gray-3) transition-colors group-hover:text-(--sl-color-text-accent)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d={isRtl ? "M15 18l-6-6 6-6" : "M9 18l6-6-6-6"} />
        </svg>
      </a>
    );
  })()}
</div>
