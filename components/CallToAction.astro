---
import type { HTMLAttributes } from "astro/types";

interface Props {
  variant: "primary" | "secondary" | "minimal";
  link: string;
  icon?: undefined | { type: "icon"; name: string } | { type: "raw"; html: string };
  attrs?: Omit<HTMLAttributes<"a">, "href">;
}

const { link, variant = "primary", icon } = Astro.props;
const { class: customClass, ...attrs } = Astro.props.attrs || {};

const styles: Record<string, string> = {
  primary: "rounded-full bg-(--sl-color-accent) px-5 py-2.5 text-sm font-medium text-white shadow-sm transition hover:ring-2 hover:ring-(--sl-color-text-accent) hover:ring-offset-2 hover:ring-offset-(--sl-color-bg)",
  secondary: "rounded-full border border-(--sl-color-gray-5) px-5 py-2.5 text-sm font-medium text-(--sl-color-text) transition hover:border-(--sl-color-accent) hover:text-(--sl-color-text-accent)",
  minimal: "text-sm font-medium text-(--sl-color-text-accent) transition hover:text-(--sl-color-white)",
};
---

<a class:list={["inline-flex items-center gap-2 no-underline", styles[variant], customClass]} href={link} {...attrs}>
  <slot />
  {icon?.type === "raw" && <Fragment set:html={icon.html} />}
</a>
