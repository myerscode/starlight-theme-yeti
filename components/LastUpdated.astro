---
const { lastUpdated, lang } = Astro.locals.starlightRoute;
---

{lastUpdated && (
  <p class="m-0 text-sm text-(--sl-color-gray-3)">
    {Astro.locals.t("page.lastUpdated")} <time datetime={lastUpdated.toISOString()}>{lastUpdated.toLocaleDateString(lang, { dateStyle: 'medium' })}</time>
  </p>
)}
